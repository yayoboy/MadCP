# ============================================================================
# MadCP - Environment Variables Configuration
# ============================================================================
#
# Copy this file to .env and fill in your actual values
# Never commit .env file to version control!
#
# Usage:
#   cp .env.example .env
#   nano .env  # Edit with your values
#
# ============================================================================

# ============================================================================
# Application Settings
# ============================================================================
APP_NAME=MadCP
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# Server configuration
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# Database - PostgreSQL
# ============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=madcp
POSTGRES_USER=madcp
POSTGRES_PASSWORD=madcp_secure_password_change_this

# Database connection string (auto-generated from above, or override)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================================================
# Redis - Cache & Message Queue
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis connection string
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Redis settings
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_KEEPALIVE=true

# Cache TTL (seconds)
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# ============================================================================
# Vector Database - Qdrant
# ============================================================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://${QDRANT_HOST}:${QDRANT_PORT}

# Collection settings
QDRANT_COLLECTION_NAME=madcp_embeddings
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE_METRIC=cosine

# ============================================================================
# LLM Providers
# ============================================================================

# Default LLM Provider (openai, anthropic, local, ollama)
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
OPENAI_TOP_P=1.0

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_MAX_TOKENS=4096

# Local LLM (Ollama, LM Studio, etc.)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=codellama:13b

# ============================================================================
# Embedding Models
# ============================================================================

# Embedding Provider (openai, huggingface, local)
EMBEDDING_PROVIDER=openai

# OpenAI Embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# HuggingFace Embeddings
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_API_TOKEN=

# Local Embedding Model
LOCAL_EMBEDDING_MODEL_PATH=/models/embeddings

# Embedding settings
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_LENGTH=8192

# ============================================================================
# Security & Authentication
# ============================================================================

# JWT Settings
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2 / OIDC (Keycloak)
OAUTH2_ENABLED=false
OAUTH2_PROVIDER_URL=http://keycloak:8080/realms/madcp
OAUTH2_CLIENT_ID=madcp-client
OAUTH2_CLIENT_SECRET=your-client-secret-here
OAUTH2_REDIRECT_URI=http://localhost:8000/auth/callback

# API Key Authentication
API_KEY_ENABLED=true
API_KEY_HEADER=X-API-Key

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# CORS
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS=*

# ============================================================================
# Code Analysis
# ============================================================================

# Tree-sitter languages to support
SUPPORTED_LANGUAGES=python,javascript,typescript,go,java,rust,cpp,ruby,php

# Analysis settings
MAX_FILE_SIZE_MB=10
MAX_REPOSITORY_SIZE_GB=5
ANALYSIS_TIMEOUT_SECONDS=300

# AST Cache
AST_CACHE_ENABLED=true
AST_CACHE_TTL=86400

# ============================================================================
# Plugin System
# ============================================================================

# Plugin configuration
PLUGINS_ENABLED=true
PLUGINS_DIR=/app/plugins
PLUGINS_AUTO_RELOAD=true
PLUGINS_RELOAD_INTERVAL=60

# Plugin sandboxing
PLUGINS_SANDBOX_ENABLED=true
PLUGINS_MAX_MEMORY_MB=512
PLUGINS_MAX_CPU_PERCENT=50

# ============================================================================
# Web UI - Frontend
# ============================================================================

# Next.js configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_NAME=MadCP
NEXT_PUBLIC_APP_VERSION=1.0.0

# Feature flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_PLUGINS=true

# ============================================================================
# Observability & Monitoring
# ============================================================================

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_METRICS_PATH=/metrics

# Grafana
GRAFANA_ENABLED=true
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_change_this

# OpenTelemetry
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=madcp-core-api

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE=/var/log/madcp/app.log

# Sentry (Error tracking)
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# Storage
# ============================================================================

# File storage backend (local, s3, minio)
STORAGE_BACKEND=local

# Local storage
STORAGE_LOCAL_PATH=/app/data/storage

# S3 / MinIO
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=madcp
S3_REGION=us-east-1
S3_USE_SSL=false

# ============================================================================
# Background Jobs & Task Queue
# ============================================================================

# Celery / Task Queue
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# Worker settings
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3000

# ============================================================================
# Email Notifications (Optional)
# ============================================================================

EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@madcp.dev
EMAIL_USE_TLS=true

# ============================================================================
# Development & Testing
# ============================================================================

# Testing
TESTING=false
TEST_DATABASE_URL=postgresql://madcp:madcp@localhost:5432/madcp_test

# Development tools
RELOAD=true
WORKERS=1

# Profiling
PROFILING_ENABLED=false
PROFILER_OUTPUT_DIR=/app/data/profiles

# ============================================================================
# Performance & Optimization
# ============================================================================

# Request timeout
REQUEST_TIMEOUT=30

# Max request size (MB)
MAX_REQUEST_SIZE_MB=100

# Response compression
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6

# Concurrency
MAX_CONCURRENT_REQUESTS=100
MAX_CONCURRENT_ANALYSIS=5

# ============================================================================
# Feature Flags
# ============================================================================

FEATURE_SEMANTIC_SEARCH=true
FEATURE_CODE_ANALYSIS=true
FEATURE_AI_ASSISTANCE=true
FEATURE_PLANNING=true
FEATURE_PLUGINS=true
FEATURE_WEB_UI=true

# Experimental features
EXPERIMENTAL_FEATURES_ENABLED=false
FEATURE_REALTIME_COLLAB=false
FEATURE_VOICE_COMMANDS=false

# ============================================================================
# Kubernetes / Cloud Configuration (Production)
# ============================================================================

# Kubernetes
K8S_NAMESPACE=madcp
K8S_SERVICE_ACCOUNT=madcp-sa

# Cloud provider (aws, gcp, azure)
CLOUD_PROVIDER=

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# GCP
GCP_PROJECT_ID=
GCP_CREDENTIALS_PATH=/secrets/gcp-credentials.json

# Azure
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=

# ============================================================================
# Backup & Recovery
# ============================================================================

BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups

# ============================================================================
# Legal & Compliance
# ============================================================================

PRIVACY_MODE=false
ANALYTICS_TRACKING=false
COOKIE_CONSENT_REQUIRED=false
GDPR_COMPLIANCE=false

# ============================================================================
# Miscellaneous
# ============================================================================

# Timezone
TZ=UTC

# Locale
LOCALE=en_US.UTF-8

# ============================================================================
# Docker Compose Specific
# ============================================================================

# Network
COMPOSE_PROJECT_NAME=madcp
DOCKER_NETWORK=madcp-network

# ============================================================================
# IMPORTANT SECURITY NOTES
# ============================================================================
#
# 1. NEVER commit .env file to version control
# 2. Change all default passwords and secrets in production
# 3. Use strong, randomly generated secrets (min 32 characters)
# 4. Enable TLS/SSL in production
# 5. Restrict CORS origins in production
# 6. Enable rate limiting in production
# 7. Use environment-specific secret management (AWS Secrets Manager, etc.)
# 8. Regularly rotate secrets and credentials
# 9. Use least privilege principle for database users
# 10. Enable audit logging in production
#
# ============================================================================
