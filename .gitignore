# MadCP - .gitignore

# ============================================================================
# Python
# ============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.pytest_cache/
.hypothesis/

# Virtual environments
venv/
ENV/
env/
.venv
.env.local

# PyCharm
.idea/

# VS Code
.vscode/
*.code-workspace

# Spyder
.spyderproject
.spyproject

# Rope
.ropeproject

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# ============================================================================
# Node.js / JavaScript / TypeScript
# ============================================================================
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Production builds
dist/
build/
.next/
out/

# Testing
coverage/

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Turbo
.turbo

# ============================================================================
# Docker
# ============================================================================
# Docker volumes
docker-data/
volumes/

# ============================================================================
# Databases
# ============================================================================
# PostgreSQL
*.sql
*.db
*.sqlite
*.sqlite3

# Database dumps
*.dump

# Allow infrastructure SQL files
!infrastructure/**/*.sql

# ============================================================================
# Environment & Secrets
# ============================================================================
.env
.env.local
.env.*.local
.env.production
.env.development
.env.test

# Secrets
secrets/
*.key
*.pem
*.crt
*.cer
*.p12
*.pfx

# ============================================================================
# Logs
# ============================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================================
# Operating System
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ============================================================================
# IDEs and Editors
# ============================================================================
# JetBrains
.idea/
*.iml
*.iws
*.ipr
.idea_modules/

# VS Code
.vscode/
*.code-workspace
.history/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
.\#*

# ============================================================================
# Build artifacts
# ============================================================================
*.o
*.a
*.so
*.dylib
*.exe
*.out
*.class
*.jar
*.war
*.ear

# ============================================================================
# Temporary files
# ============================================================================
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# ============================================================================
# MadCP Specific
# ============================================================================
# Local data
data/
cache/
repositories/
embeddings/
checkpoints/

# Plugin data
plugins/*/data/
plugins/*/cache/

# Vector database data
qdrant_data/
vector_storage/

# Monitoring data
prometheus_data/
grafana_data/

# Upload directories
uploads/
downloads/

# Local configuration overrides
config/local.yaml
config/*.local.yaml

# Development databases
dev.db
test.db

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# Model files (large)
*.h5
*.pkl
*.pickle
*.joblib
*.bin
*.pt
*.pth
*.onnx

# ============================================================================
# Cloud & Infrastructure
# ============================================================================
# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
.terraform.lock.hcl

# Kubernetes
*.kubeconfig

# ============================================================================
# Documentation builds
# ============================================================================
docs/_build/
docs/.doctrees/
site/

# ============================================================================
# Misc
# ============================================================================
.python-version
.ruby-version
.node-version
